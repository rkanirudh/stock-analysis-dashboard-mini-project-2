// ==============================================================================
// POWER BI DAX MEASURES LIBRARY
// Project: Data-Driven Stock Analysis Dashboard
// Description: Central measure repository categorized by reporting functional area.
// ==============================================================================

// ------------------------------------------------------------------------------
// SECTION 1: BASE SYSTEM & MARKET KPIS
// ------------------------------------------------------------------------------

/*
1. Total Companies
Count of unique constituent companies in the Nifty 50 analysis pool.
Display Folder: Core KPIs
Format: #,##0
*/
Total Companies = 
    DISTINCTCOUNT(Dim_Company[Ticker])

/*
2. Total Records
Total transactional price observation rows analyzed across the stock dataset.
Display Folder: Core KPIs
Format: #,##0
*/
Total Records = 
    COUNTROWS(Fact_DailyReturn)

/*
3. Total Sectors
Count of distinct industry sectors covered in the market dataset.
Display Folder: Core KPIs
Format: #,##0
*/
Total Sectors = 
    DISTINCTCOUNT(Dim_Company[Sector])


// ------------------------------------------------------------------------------
// SECTION 2: PRICE & VOLUME STATISTICAL MEASURES
// ------------------------------------------------------------------------------

/*
4. Average Closing Price
Mean closing price across all selected stocks and time frames (in INR ₹).
Display Folder: Price Metrics
Format: ₹#,##0.00
*/
Average Closing Price = 
    AVERAGE(Fact_DailyReturn[ClosePrice])

/*
5. Highest Stock Price
Maximum closing price recorded in the dataset.
Display Folder: Price Metrics
Format: ₹#,##0.00
*/
Highest Stock Price = 
    MAX(Fact_DailyReturn[ClosePrice])

/*
6. Lowest Stock Price
Minimum closing price recorded in the dataset.
Display Folder: Price Metrics
Format: ₹#,##0.00
*/
Lowest Stock Price = 
    MIN(Fact_DailyReturn[ClosePrice])

/*
7. Average Trading Volume
Mean daily trading volume across sector and monthly aggregations.
Display Folder: Volume Metrics
Format: #,##0
*/
Average Trading Volume = 
    AVERAGE(Sector_Analysis[AverageVolume])


// ------------------------------------------------------------------------------
// SECTION 3: RETURN & RISK PERFORMANCE MEASURES
// ------------------------------------------------------------------------------

/*
8. Average Daily Return
Average percentage daily price change across selected stocks.
Display Folder: Performance Metrics
Format: +0.00%;-0.00%;0.00%
*/
Average Daily Return = 
    AVERAGE(Fact_DailyReturn[DailyReturnPct]) / 100.0

/*
9. Average Volatility
Average daily return standard deviation (annualized volatility level).
Display Folder: Performance Metrics
Format: 0.00%
*/
Average Volatility = 
    AVERAGE(Risk_Return_Analysis[VolatilityPct]) / 100.0

/*
10. Average Yearly Return
Mean net 1-year percentage price return across selected stocks.
Display Folder: Performance Metrics
Format: +0.00%;-0.00%;0.00%
*/
Average Yearly Return = 
    AVERAGE(Yearly_Return[YearlyReturnPct]) / 100.0


// ------------------------------------------------------------------------------
// SECTION 4: DYNAMIC SLICER SELECTION MEASURES (STOCK ANALYSIS PAGE)
// ------------------------------------------------------------------------------

/*
11. Selected Stock Close
Dynamically evaluated daily closing price for the stock selected in ticker slicer.
Display Folder: Dynamic Stock Analysis
Format: ₹#,##0.00
*/
Selected Stock Close = 
    IF(
        HASONEVALUE(Dim_Company[Ticker]),
        AVERAGE(Fact_DailyReturn[ClosePrice]),
        BLANK()
    )

/*
12. Selected MA20
Dynamically evaluated 20-Day Simple Moving Average for the selected stock.
Display Folder: Dynamic Stock Analysis
Format: ₹#,##0.00
*/
Selected MA20 = 
    IF(
        HASONEVALUE(Dim_Company[Ticker]),
        AVERAGE(Fact_MovingAverage[MA20]),
        BLANK()
    )

/*
13. Selected MA50
Dynamically evaluated 50-Day Simple Moving Average for the selected stock.
Display Folder: Dynamic Stock Analysis
Format: ₹#,##0.00
*/
Selected MA50 = 
    IF(
        HASONEVALUE(Dim_Company[Ticker]),
        AVERAGE(Fact_MovingAverage[MA50]),
        BLANK()
    )

/*
14. Selected Stock Daily Return
Daily return percentage for the active slicer selection.
Display Folder: Dynamic Stock Analysis
Format: +0.00%;-0.00%;0.00%
*/
Selected Stock Daily Return = 
    IF(
        HASONEVALUE(Dim_Company[Ticker]),
        AVERAGE(Fact_DailyReturn[DailyReturnPct]) / 100.0,
        BLANK()
    )

/*
15. Selected Stock Volatility
Volatility level for the active slicer selection.
Display Folder: Dynamic Stock Analysis
Format: 0.00%
*/
Selected Stock Volatility = 
    IF(
        HASONEVALUE(Dim_Company[Ticker]),
        SELECTEDVALUE(Volatility[Volatility]),
        BLANK()
    )

/*
16. Selected Stock Yearly Return
Net yearly return for the active slicer selection.
Display Folder: Dynamic Stock Analysis
Format: +0.00%;-0.00%;0.00%
*/
Selected Stock Yearly Return = 
    IF(
        HASONEVALUE(Dim_Company[Ticker]),
        SELECTEDVALUE(Yearly_Return[YearlyReturnPct]) / 100.0,
        BLANK()
    )


// ------------------------------------------------------------------------------
// SECTION 5: EXECUTIVE & LEADERBOARD MEASURES
// ------------------------------------------------------------------------------

/*
17. Top Gainer Ticker
Name of the top-performing stock in the analysis period.
Display Folder: Executive Leaderboard
Format: Text
*/
Top Gainer Ticker = 
    TOPN(1, ALL(Yearly_Return), Yearly_Return[YearlyReturnPct], DESC)

/*
18. Top Gainer Return
Yearly return percentage of the top gainer stock.
Display Folder: Executive Leaderboard
Format: +0.00%
*/
Top Gainer Return = 
    MAXX(TOPN(1, ALL(Yearly_Return), Yearly_Return[YearlyReturnPct], DESC), Yearly_Return[YearlyReturnPct]) / 100.0

/*
19. Top Loser Ticker
Name of the worst-performing stock in the analysis period.
Display Folder: Executive Leaderboard
Format: Text
*/
Top Loser Ticker = 
    TOPN(1, ALL(Yearly_Return), Yearly_Return[YearlyReturnPct], ASC)

/*
20. Top Loser Return
Yearly return percentage of the top loser stock.
Display Folder: Executive Leaderboard
Format: -0.00%
*/
Top Loser Return = 
    MINX(TOPN(1, ALL(Yearly_Return), Yearly_Return[YearlyReturnPct], ASC), Yearly_Return[YearlyReturnPct]) / 100.0


// ------------------------------------------------------------------------------
// SECTION 6: RISK CLASSIFICATION & SEGMENTATION MEASURES
// ------------------------------------------------------------------------------

/*
21. High Risk Stocks Count
Count of companies with Volatility > 2.0%.
Display Folder: Risk Metrics
Format: #,##0
*/
High Risk Stocks Count = 
    CALCULATE(
        COUNTROWS(Volatility),
        Volatility[Volatility] >= 0.02
    )

/*
22. Low Risk Stocks Count
Count of companies with Volatility < 1.5%.
Display Folder: Risk Metrics
Format: #,##0
*/
Low Risk Stocks Count = 
    CALCULATE(
        COUNTROWS(Volatility),
        Volatility[Volatility] < 0.015
    )

/*
23. Stock Volatility Status KPI
Text badge indicating risk level based on standard deviation threshold.
Display Folder: Risk Metrics
Format: Text
*/
Stock Risk Status = 
    VAR CurrentVol = AVERAGE(Volatility[Volatility])
    RETURN
    SWITCH(
        TRUE(),
        CurrentVol >= 0.025, "High Volatility",
        CurrentVol >= 0.018, "Moderate Volatility",
        "Low Volatility"
    )
